          },
          "expr": "histogram_quantile(0.99, sum by (le, profile) (rate(queuebench_send_seconds_bucket[5s])))",
          "legendFormat": "{{profile}} send",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, profile) (rate(queuebench_receive_seconds_bucket[5s])))",
          "legendFormat": "{{profile}} receive",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
